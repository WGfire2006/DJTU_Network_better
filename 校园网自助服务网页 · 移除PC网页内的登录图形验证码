// ==UserScript==
// @name         校园网自助 · 移除PC网页内的登录图形验证码
// @author       WGfire
// @namespace    local.campus.selfservice
// @version      2.0.0
// @description  静默移除校园网自助服务系统登录页的图形验证码；账号密码仍由你手动输入
// @match        http://10.1.1.200:8080/*
// @run-at       document-start
// @grant        none
// @icon data:image/png;base64,
// ==/UserScript==
/*
 * 保留不动的元素：#verifyMsg、#verifyError、#verifyDiv
 *   （login_self.js 里有代码按 id 读取它们，删除会报错，所以只隐藏/改属性）
 */

(function () {
  'use strict';

  // 立即隐藏，避免验证码闪现（按 id 选择，这样去掉 name 后依然保持隐藏）
  var CSS = '#verifyDiv,#verify,#verify_text,#identity{display:none !important;}';

  function injectStyle() {
    if (document.getElementById('rj-nocaptcha-style')) return true;
    var host = document.head || document.documentElement;
    if (!host) return false;
    var s = document.createElement('style');
    s.id = 'rj-nocaptcha-style';
    s.textContent = CSS;
    host.appendChild(s);
    return true;
  }

  function killCaptcha() {
    var v = document.getElementById('verify');
    if (v) v.removeAttribute('name'); // 关键：去掉 name，表单提交就不会带 verify 参数

    var anchor = document.getElementById('identity') || v;
    var tr = anchor && anchor.closest ? anchor.closest('tr') : null;
    if (tr) tr.style.display = 'none'; // 整行一起隐藏，不留空白
  }

  if (!injectStyle()) {
    var mo = new MutationObserver(function () {
      if (injectStyle()) mo.disconnect();
    });
    mo.observe(document.documentElement || document, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', killCaptcha, { once: true });
  } else {
    killCaptcha();
  }
})();
